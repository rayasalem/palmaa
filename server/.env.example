# Node environment (development | production | test)
NODE_ENV=development

# Server
PORT=5000

# Supabase (required for DB)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_service_role_key

# Frontend (CORS and redirects - comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# JWT for API auth (64+ char hex recommended; run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# Optional: encryption for sensitive fields (32-byte hex = 64 chars)
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: cookie signing
# COOKIE_SECRET=optional-cookie-secret

# Sandbox payment
SANDBOX_PAYMENT_URL=http://localhost:5000/sandbox-pay

# LogesTechs / Shipment (https://www.postman.com/ali-asfour/logestech-s-api/collection/1kmztpz/logestechs-apis)
LOGESTECHS_COMPANY_ID=634
SHIPMENT_API_BASE=https://apisv2.logestechs.com/api
LOGESTECHS_EMAIL=your-logestechs-account@email.com
LOGESTECHS_PASSWORD=your-logestechs-password
# LOG_SHIPMENT_REQUESTS=true   # Set to log full request/response for debugging
# Optional: sender defaults for shipment creation
# SENDER_NAME=Palma Marketplace
# SENDER_PHONE=0599000000
# SENDER_ADDRESS_LINE1=...
# SENDER_CITY_ID=...
# SENDER_VILLAGE_ID=...
# SENDER_REGION_ID=...

# Resend (مفضل – إرسال البريد بدون SMTP). احصل على المفتاح من: Resend Dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# عنوان المرسل (يجب أن يكون من دومين موثّق عند Resend، مثلاً palma.ps)
RESEND_FROM=Palma <noreply@palma.ps>

# SMTP (احتياطي فقط إذا لم تضبط RESEND_API_KEY)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=Palma <info@yourdomain.com>
# Optional: when SMTP fails, return OTP in API response (testing only)
# RETURN_OTP_WHEN_EMAIL_FAILS=true

# Arabic Bank Payment Gateway
ARABIC_BANK_API_URL=https://api.arabicbank.example/v1
ARABIC_BANK_MERCHANT_ID=your_merchant_id
ARABIC_BANK_SECRET_KEY=your_webhook_secret

# Chatbot AI – مجاني: Groq (أولوية) أو OpenAI اختياري
# مفتاح مجاني من: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# اختياري: OpenAI إذا لم تستخدم Groq
# OPENAI_API_KEY=sk-...

# Optional
# ORDERS_TABLE=orders
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX=200
# LOG_LEVEL=info
