# Palma Marketplace - STAGING
# Use staging Supabase project; inject via CI/CD or server env.
NODE_ENV=staging
PORT=5000
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_KEY=your_staging_service_role_key
FRONTEND_URL=https://staging.palma.ps
JWT_SECRET=staging-jwt-secret-min-64-chars-unique
JWT_EXPIRES_IN=7d
COOKIE_SECRET=staging-cookie-secret
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=50
LOG_LEVEL=info
HEALTH_CHECK_PAYMENT=false
