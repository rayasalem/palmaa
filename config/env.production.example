# =============================================================================
# Palma Marketplace – PRODUCTION environment
# Store in secrets manager / server env; never commit.
# =============================================================================

NODE_ENV=production
PORT=5000

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_KEY=your_production_service_role_key

FRONTEND_URL=https://palma.ps,https://www.palma.ps

JWT_SECRET=production-jwt-secret-min-64-chars-from-secrets-manager
JWT_EXPIRES_IN=7d
COOKIE_SECRET=production-cookie-secret
ENCRYPTION_KEY=64-char-hex-for-sensitive-fields

# Cybersource production
CYBS_REST_HOST=https://api.cybersource.com
CYBS_REST_MERCHANT_ID=
CYBS_REST_KEY_ID=
CYBS_REST_SECRET_KEY=

LOGESTECHS_COMPANY_ID=
SHIPMENT_API_BASE=https://apisv2.logestechs.com/api
LOGESTECHS_EMAIL=
LOGESTECHS_PASSWORD=

RESEND_API_KEY=
RESEND_FROM=Palma <noreply@palma.ps>

RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

HEALTH_CHECK_PAYMENT=true
