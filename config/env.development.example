# Palma Marketplace - DEVELOPMENT
# Copy to .env (root and server); never commit real secrets.
NODE_ENV=development
PORT=5000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=your_dev_service_role_key
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=dev-jwt-secret-min-64-chars-change-in-staging-and-production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=100
LOG_LEVEL=debug
