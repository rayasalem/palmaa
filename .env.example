
# Supabase Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary Credentials
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-preset

# SendGrid Credentials (Real Email Sending)
# Warning: Calling SendGrid directly from the browser may encounter CORS issues.
# Use a proxy or Supabase Edge Function in production.
VITE_SENDGRID_API_KEY=SG.xxxxxxxx.xxxxxxx
VITE_SENDER_EMAIL=noreply@palma.ps

# FlashLine Logistics (Optional)
VITE_FLASHLINE_API_URL=https://apisv2.logestechs.com/api

# Backend API for checkout (orders, payment, shipment).
# Production / staging: always use https:// to avoid mixed-content (blocked requests on HTTPS pages).
# Local backend only: VITE_API_URL=http://localhost:5000
# Production — always HTTPS (cPanel frontend + Render API):
#   VITE_API_URL=https://your-service.onrender.com
#   or custom domain on Render:
#   VITE_API_URL=https://api.palma.ps
VITE_API_URL=https://palmaa.onrender.com

# --- HTTPS policy (browser bundle) ---
# Optional: HTTPS endpoint that proxies legacy http:// resources (query: ?url=encoded-original)
# Deploy your own worker/nginx; see docs/HTTPS-POLICY.md
# VITE_HTTP_LEGACY_PROXY=https://your-domain.com/api/https-legacy-proxy
# Set to "false" only if you must block http:// even to localhost (advanced).
# VITE_ALLOW_HTTP_LOCALHOST=true
